		and (root.Size.Y * 0.5 + math.max(humanoid.HipHeight, 0.5))
		or (root.Size.Y * 0.5 + 2)
	hoverPadInstance.CFrame = CFrame.new(
		rootPosition.X,
		rootPosition.Y - feetOffset - HOVER_PAD_THICKNESS * 0.5 - 0.05,
		rootPosition.Z
	)
	return true
