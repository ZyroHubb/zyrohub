if r then
    return type(r) == "table" and (r.DisplayName or r._id or r.Name) or tostring(r)
end
local dir = getAssetDir()
local cat = egg.AssetCategory or egg.Category or egg.Name
if dir and cat and dir[cat] and dir[cat].Rarity then
    local rr = dir[cat].Rarity
    return type(rr) == "table" and (rr.DisplayName or rr._id) or tostring(rr)
end
return "Common"
end
local function mutationMult(rec)
local m = 1
local muts = rec.Mutations or rec.Mutation
if type(muts) == "table" then
    for _, mm in pairs(muts) do
        if type(mm) == "table" then
            m = m * (tonumber(mm.Multiplier or mm.Value or mm.Scale) or 1.5)
        else
            local t = tostring(mm):lower()
            if t:find"rainbow" then m = m * 3
            elseif t:find"gold" then m = m * 2
            elseif t:find"silver" then m = m * 1.5
            elseif t:find"parasite" or t:find"monstrous" then m = m * 5
            else m = m * 1.25 end
        end
    end
elseif muts then
    m = m * 1.5
end
if rec.HasParasite then m = m * 5 end
return m
end
local function eggMoney(rec)
local cat = tostring(rec.AssetCategory or rec.Category or rec.Name or "Egg")
local info = getAssetInfo(cat)
local raw = tonumber(rec.Money or rec.Cash or rec.Income or rec.EarningRate or rec.Value or rec.Price)
if (not raw or raw <= 0) and type(info) == "table" then
    raw = tonumber(info.Money or info.Cash or info.Income or info.EarningRate or info.ProfileIncome or info.SalePrice or info.Price)
    if (not raw or raw <= 0) and type(info.Egg) == "table" then
        raw = tonumber(info.Egg.Money or info.Egg.Income or info.Egg.EarningRate or info.Egg.SalePrice)
    end
end
raw = tonumber(raw) or 0
local scale = tonumber(rec.AssetScale or rec.Scale or rec.NestScale) or 1
local v = raw * scale * mutationMult(rec)
if v <= 0 then
    local rn = getRarityName(rec)
    local score = RARITY_SCORE[rn] or 100
    local zone = tonumber(tostring(rec.AreaId or ""):match"%d+") or 50
    v = score * math.max(zone, 50) * math.max(scale, 1)
end
return v
end
local function formatMoney(n)
n = tonumber(n) or 0
if n >= 1000000000000 then return string.format("%.2fT", n/1000000000000) end
if n >= 1000000000 then return string.format("%.2fB", n/1000000000) end
if n >= 1000000 then return string.format("%.2fM", n/1000000) end
if n >= 1000 then return string.format("%.2fK", n/1000) end
return tostring(math.floor(n + 0.5))
end
