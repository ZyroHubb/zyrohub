	local disabledUGIConnections = {}
	local shieldConnection = nil
	local shieldHeartbeatTimer = 0

	local function disableUGIMonitors()
		if type(getconnections) ~= "function" then return end
		for _, event in ipairs({RunService.Heartbeat, RunService.PreSimulation, RunService.PostSimulation}) do
			local ok, conns = pcall(getconnections, event)
			if ok and type(conns) == "table" then
				for _, conn in ipairs(conns) do
					local ok2, fn = pcall(function() return conn.Function end)
					if ok2 and type(fn) == "function" then
						local ok3, src = pcall(debug.info, fn, "s")
						if ok3 and string.find(tostring(src), "UGI", 1, true) then
							local ok4, enabled = pcall(function() return conn.Enabled end)
							if not ok4 or enabled ~= false then
								if pcall(function() conn:Disable() end) then
									table.insert(disabledUGIConnections, conn)
								end
							end
						end
					end
				end
			end
		end
	end

	local function restoreUGIMonitors()
		if shieldConnection then
			shieldConnection:Disconnect()
			shieldConnection = nil
		end
		for _, conn in ipairs(disabledUGIConnections) do
			pcall(function() conn:Enable() end)
		end
		table.clear(disabledUGIConnections)
	end

	function Shield.Activate(tag)
		shieldTags[tag] = true
		pcall(disableUGIMonitors)

		if not shieldConnection then
			shieldHeartbeatTimer = 0
			shieldConnection = RunService.Heartbeat:Connect(function(dt)
				shieldHeartbeatTimer = shieldHeartbeatTimer + dt
				if shieldHeartbeatTimer >= 3 then
					shieldHeartbeatTimer = 0
					pcall(disableUGIMonitors)
				end
			end)
		end
	end

	function Shield.Deactivate(tag)
		shieldTags[tag] = nil
		if next(shieldTags) == nil then
			restoreUGIMonitors()
		end
	end
end

local function restoreCharacterMovement()
	local char = localPlayer.Character
	if not char then return end

	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("WeldConstraint") and desc.Name:find("RigidJointWeld_") then
			pcall(function() desc:Destroy() end)
		end
		if desc:IsA("Motor6D") then
			desc.Enabled = true
		end
		if desc:IsA("BasePart") then
			desc.CanTouch = true
			if desc.Name ~= "HumanoidRootPart" then
				desc.CanCollide = true
			end
		end
	end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if hum then
		hum.AutoRotate    = true
		hum.PlatformStand = false
		hum.Sit           = false

		if hum.WalkSpeed < 16 then
			hum.WalkSpeed = 16
		end
		if hum.JumpPower < 50 then
			hum.JumpPower = 50
		end

		hum:SetStateEnabled(Enum.HumanoidStateType.Running,  true)
		hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,  true)
		hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
		hum:SetStateEnabled(Enum.HumanoidStateType.Seated,   false)
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end

	if hrp then
		hrp.Anchored = false
		hrp.AssemblyLinearVelocity  = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero

		pcall(function()
			hrp:SetNetworkOwner(localPlayer)
		end)
	end

	local cam = Workspace.CurrentCamera
	if cam then
		pcall(function()
			cam.CameraType = Enum.CameraType.Custom
			if hum then
				cam.CameraSubject = hum
			end
		end)
	end
end

