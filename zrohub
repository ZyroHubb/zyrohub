local function resolveEggInstance(eggInfo)
	if not eggInfo then return nil end
	if typeof(eggInfo) == "Instance" then
		return eggInfo
	end
	if eggInfo.instance and typeof(eggInfo.instance) == "Instance" and eggInfo.instance.Parent and eggInfo.instance:IsDescendantOf(workspace) then
		return eggInfo.instance
	end
	if eggInfo.Model and typeof(eggInfo.Model) == "Instance" and eggInfo.Model.Parent and eggInfo.Model:IsDescendantOf(workspace) then
		return eggInfo.Model
	end

	local uid = tostring(eggInfo.uid or eggInfo.Uid or "")
	local slot = tostring(eggInfo.slotKey or eggInfo.SlotKey or "")

	local slots = workspace:FindFirstChild("AreaEggSlotsClient")
	if slots then
		if uid ~= "" then
			local found = slots:FindFirstChild(uid, true)
			if found and found:IsA("PVInstance") then return found end
			for _, child in ipairs(slots:GetChildren()) do
				if child.Name == uid or child:GetAttribute("UID") == uid or child:GetAttribute("Uid") == uid or child:GetAttribute("EggUid") == uid then
					return child
				end
			end
		end
		if slot ~= "" then
			local found = slots:FindFirstChild(slot, true)
			if found and found:IsA("PVInstance") then return found end
		end
	end

	if uid ~= "" then
		local direct = workspace:FindFirstChild(uid)
		if direct and direct:IsA("PVInstance") then return direct end
		for _, child in ipairs(workspace:GetChildren()) do
			if child:IsA("Model") and (child.Name == uid or child:GetAttribute("UID") == uid or child:GetAttribute("Uid") == uid) then
				return child
			end
		end
	end

	return nil
end

local function resolveTargetCFrame(eggInfo)
	if not eggInfo then return nil end
	if typeof(eggInfo) == "CFrame" then return eggInfo end
	if typeof(eggInfo) == "Vector3" then return CFrame.new(eggInfo) end
	if typeof(eggInfo) == "Instance" then
		if eggInfo:IsA("Model") then return eggInfo:GetPivot() end
		if eggInfo:IsA("BasePart") then return eggInfo.CFrame end
	end
	if eggInfo.BottomCFrame and typeof(eggInfo.BottomCFrame) == "CFrame" and eggInfo.BottomCFrame ~= CFrame.new() then
		return eggInfo.BottomCFrame
	end
	if eggInfo.CFrame and typeof(eggInfo.CFrame) == "CFrame" and eggInfo.CFrame ~= CFrame.new() then
		return eggInfo.CFrame
	end
	if eggInfo.BoundsCFrame and typeof(eggInfo.BoundsCFrame) == "CFrame" and eggInfo.BoundsCFrame ~= CFrame.new() then
		return eggInfo.BoundsCFrame
	end
	if eggInfo.Position and typeof(eggInfo.Position) == "Vector3" then
		return CFrame.new(eggInfo.Position)
	end

	local inst = resolveEggInstance(eggInfo)
	if inst then
		if inst:IsA("Model") then return inst:GetPivot() end
		if inst:IsA("BasePart") then return inst.CFrame end
	end

	local uid = eggInfo.uid or eggInfo.Uid
	local slots = workspace:FindFirstChild("AreaEggSlotsClient")
	if slots and uid then
		local found = slots:FindFirstChild(tostring(uid), true)
		if found then return found:GetPivot() end
	end
	return nil
end

