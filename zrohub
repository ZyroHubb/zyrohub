tbl2.startNewTeleguiado = function()
	local newTGRuntime = tbl2.newTGRuntime
	if newTGRuntime.running then
		return false
	end
	if tick() < (newTGRuntime.cooldownUntil or 0) then
		return false
	end
	if not tbl4.enabled then
		return false
	end

	if not tbl2.canLeaveForSteal() then
		tbl4.waitingForDay = true
		tbl2.updateToggle()
		return false
	end

	tbl4.mode = "TELEGUIADO"
	tbl4.waitingForDay = false
	newTGRuntime.running = true
	tbl2.updateToggle()

	if newTGRuntime.thread then
		pcall(task.cancel, newTGRuntime.thread)
		newTGRuntime.thread = nil
	end

	newTGRuntime.thread = task.spawn(function()
		while tbl4.enabled and newTGRuntime.running do
			if not tbl2.canLeaveForSteal() then
				tbl4.waitingForDay = true
				tbl2.updateToggle()
				tbl2.showToast(tbl2.isDaytime() and "Aguardando portao abrir..." or "Modo armado: aguardando dia...")
				while (not tbl2.canLeaveForSteal()) and tbl4.enabled and newTGRuntime.running do
					task.wait(1)
				end
				if not tbl4.enabled or not newTGRuntime.running then
					break
				end
				tbl4.waitingForDay = false
				tbl2.updateToggle()
			end

			local targetEgg = getBestEggToSteal()
			if not targetEgg then
				tbl2.setGoStatus("GO - Buscando ovo...")
				tbl2.showToast("Nenhum ovo encontrado. Atualizando...")
				task.wait(1.5)
				pcall(function() tbl2.refreshEggs(true) end)
				if not tbl4.loopEnabled then
					break
				end
			else
				local eggName = tostring(targetEgg.Name or targetEgg.name or targetEgg.Uid or targetEgg.uid or "Egg")
				tbl2.setGoStatus("GO - " .. string.sub(eggName, 1, 14) .. "...")
				pcall(function() tbl2.showPetTargetNotification(targetEgg) end)
				tbl2.showToast("Iniciando Auto Steal: " .. eggName)

				local success = executeEggSteal(targetEgg, not tbl4.loopEnabled)
				if success then
					tbl2.showToast("Ovo entregue com sucesso!")
					task.wait(0.5)
				else
					task.wait(1)
				end

				if not tbl4.loopEnabled then
					break
				end
			end

			task.wait(0.5)
		end

		newTGRuntime.running = false
		tbl4.enabled = false
		tbl4.runLoop = false
		tbl4.waitingForDay = false
		pcall(chilliEndFlight)
		pcall(restoreCharacterMovement)
		pcall(function() Shield.Deactivate("steal") end)
		tbl2.updateToggle()
		textLabel9.Text = "Always targets the highest value"
	end)

	return true
end

