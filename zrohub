local function executeEggSteal(targetEgg, isOneShot)
	if not targetEgg then return false end
	if isNight() then
		warn("[Auto Steal] Noite no servidor! Aguardando o dia...")
		return false
	end

	isAutoStealActive = true
	local targetUid = tostring(targetEgg.uid or targetEgg.Uid or "")
	local targetCF = resolveTargetCFrame(targetEgg)
	if not targetCF or targetCF == CFrame.new() then
		warn("[Auto Steal] CFrame do ovo não pode ser resolvido!")
		isAutoStealActive = false
		return false
	end

	local record = {
		Uid = targetUid,
		BoundsCFrame = targetCF,
		CFrame = targetCF,
		PhysicalModel = resolveEggInstance(targetEgg),
		AssetCategory = targetEgg.AssetCategory or targetEgg.Category or targetEgg.Name or targetEgg.name,
		AreaId = targetEgg.AreaId,
		State = targetEgg.State or "Slot",
	}

	tbl2.setGoStatus("GO - Natsu Steal...")
	local ok, result, msg = pcall(function()
		return stealEggV8(record)
	end)
	isAutoStealActive = false
	pcall(restoreCharacterMovement)
	pcall(chilliEndFlight)

	if not ok then
		warn("[Auto Steal] Erro no motor Natsu: " .. tostring(result))
		return false
	end
	if result ~= true then
		tbl2.setGoStatus("GO - Falha ao coletar")
		warn("[Auto Steal] Natsu Steal falhou: " .. tostring(msg))
		return false
	end
	tbl2.setGoStatus("GO - Entregue")
	return true
end

local function getBestEggToSteal()
	pcall(function() tbl2.refreshEggs(true) end)

	local selected = tbl2.getActiveTargetEgg and tbl2.getActiveTargetEgg()
	if selected then
		return selected
	end

	if tbl4.selectedEgg then
		return tbl4.selectedEgg
	end

	if tbl4.targetEgg then
		return tbl4.targetEgg
	end

	if type(tbl4.filteredEggs) == "table" and #tbl4.filteredEggs > 0 then
		return tbl4.filteredEggs[1]
	end

	if type(tbl4.allEggs) == "table" and #tbl4.allEggs > 0 then
		return tbl4.allEggs[1]
	end

	if tbl2.getSnapshot then
		local snap = tbl2.getSnapshot()
		if snap and type(snap.Records) == "table" then
			for _, rec in pairs(snap.Records) do
				if rec.Uid and (rec.State == "Slot" or rec.State == "Dropped") and rec.BottomCFrame then
					return rec
				end
			end
		end
	end

	return nil
end

