local function getAssetInfo(cat)
local dir = getAssetDir()
if not dir or not cat or cat == "" then return nil end
if dir[cat] then return dir[cat] end
local k = normKey(cat)
for kk, v in pairs(dir) do
    if normKey(kk) == k then return v end
    if type(v) == "table" and (normKey(v.DisplayName) == k or normKey(v.Name) == k) then
        return v
    end
end
return nil
end
